+#[tokio::test]
+async fn steering_claim_is_hidden_and_cannot_be_edited_or_dispatched() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let queue = runtime.thread_queue();
+    let first = queue.enqueue(thread_id, r#"{"n":1}"#).await.unwrap();
+    let second = queue.enqueue(thread_id, r#"{"n":2}"#).await.unwrap();
+    let third = queue.enqueue(thread_id, r#"{"n":3}"#).await.unwrap();
+
+    let claimed = queue
+        .claim_steer(thread_id, &second.id, "active-turn")
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(claimed.steering_turn_id.as_deref(), Some("active-turn"));
+    assert!(
+        queue
+            .claim_steer(thread_id, &second.id, "other-turn")
+            .await
+            .unwrap()
+            .is_none()
+    );
+    assert!(
+        queue
+            .update(thread_id, &second.id, r#"{"n":4}"#)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    assert!(!queue.delete(thread_id, &second.id).await.unwrap());
+    assert_eq!(
+        vec![first.clone(), third.clone()],
+        queue.list_page(thread_id, 0, 10).await.unwrap()
+    );
+    assert_eq!(
+        vec![claimed.clone()],
+        queue.list_steering(thread_id).await.unwrap()
+    );
+    let reopened = StateRuntime::init(runtime.sqlite().clone(), "test-provider".to_string())
+        .await
+        .unwrap();
+    assert_eq!(
+        vec![claimed.clone()],
+        reopened
+            .thread_queue()
+            .list_steering(thread_id)
+            .await
+            .unwrap()
+    );
+
+    // Reordering visible rows must not collide with the hidden row's unique order.
+    queue
+        .reorder(thread_id, &[third.id.clone(), first.id.clone()])
+        .await
+        .unwrap();
+    assert!(
+        !queue
+            .settle_steer(thread_id, &second.id, "wrong-turn")
+            .await
+            .unwrap()
+    );
+    assert!(
+        queue
+            .release_steer(thread_id, &second.id, "active-turn")
+            .await
+            .unwrap()
+    );
+    assert!(queue.list_steering(thread_id).await.unwrap().is_empty());
+    assert_eq!(3, queue.list_page(thread_id, 0, 10).await.unwrap().len());
+
+    assert!(
+        queue
+            .claim_steer(thread_id, &second.id, "active-turn")
+            .await
+            .unwrap()
+            .is_some()
+    );
+    assert!(
+        !queue
+            .discard_steer(thread_id, &second.id, "wrong-turn")
+            .await
+            .unwrap()
+    );
+    assert_eq!(1, queue.list_steering(thread_id).await.unwrap().len());
+    assert!(
+        queue
+            .discard_steer(thread_id, &second.id, "active-turn")
+            .await
+            .unwrap()
+    );
+    assert!(
+        !queue
+            .discard_steer(thread_id, &second.id, "active-turn")
+            .await
+            .unwrap()
+    );
+    assert_eq!(2, queue.list_page(thread_id, 0, 10).await.unwrap().len());
+}
