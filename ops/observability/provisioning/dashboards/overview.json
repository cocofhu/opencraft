{
  "uid": "opencraft-overview",
  "title": "OpenCraft platform monitoring",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "opencraft",
    "observe-v1.1.3"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Platform and collection status",
      "description": "platform.status; resource_sample; observe-v1.1.3. Absence of samples does not establish health. Exact rolling domain gauges are evaluated at the selected timestamp; counters/histograms are estimates.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opencraft-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opencraft_producer_age_seconds",
          "legendFormat": "{{component}}{{operation}}{{method}}{{outcome}}{{engine}}{{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Successful foreground interactive latency (5m estimate)",
      "description": "operations.latency; histogram_approximation; observe-v1.1.3. Absence of samples does not establish health. Exact rolling domain gauges are evaluated at the selected timestamp; counters/histograms are estimates.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opencraft-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation, cache, engine) (rate(opencraft_interactive_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{component}}{{operation}}{{method}}{{outcome}}{{engine}}{{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Observed operation outcomes by source (5m estimate)",
      "description": "operations.outcomes; histogram_approximation; observe-v1.1.3. Absence of samples does not establish health. Exact rolling domain gauges are evaluated at the selected timestamp; counters/histograms are estimates.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opencraft-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome, origin) (increase(opencraft_observed_operations_total[5m]))",
          "legendFormat": "{{component}}{{operation}}{{method}}{{outcome}}{{engine}}{{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Recovery episodes (exact domain aggregation)",
      "description": "recovery.episodes; exact_domain_aggregation; observe-v1.1.3. Absence of samples does not establish health. Exact rolling domain gauges are evaluated at the selected timestamp; counters/histograms are estimates.",
      "gridPos": {
        "x": 12,
